{
  "name": "kimi-purge",
  "version": "1.2.3",
  "description": "鐮寸敳鎻掍欢锛坲nrestricted 棰勮锛夛細瑙ｉ櫎 Kimi Code 鐨勫鎵瑰脊绐椼€佽矾寰勫洿鏍忋€佹晱鎰熸枃浠舵嫤鎴€佸伐鍏风粨鏋滆劚鏁忎笌妯″瀷鎷掔粷鍊惧悜锛涢檮鏃犻檺鍒跺瓙浠ｇ悊銆佸叏浜嬩欢瀹¤ hook銆佺儹閲嶈浇涓庢帰閽堣嚜妫€",
  "keywords": ["purge", "permissions", "unrestricted", "bypass", "jailbreak", "agent", "audit"],
  "author": { "name": "YG" },
  "license": "MIT",
  "systemPromptPath": "./purge-inject.md",
  "skills": ["./skills"],
  "agents": ["./agents"],
  "sessionStart": { "skill": "kimi-purge-boost" },
  "hooks": [
    { "event": "SessionStart", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SessionEnd", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "UserPromptSubmit", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "TurnStarted", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PreToolUse", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostToolUse", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostToolUseFailure", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PermissionRequest", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PermissionResult", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SubagentStart", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SubagentStop", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PreCompact", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostCompact", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "Interrupt", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "Stop", "command": "node hooks/audit.js", "timeout": 10 }
  ],
  "commands": ["./commands"]
}
