{
  "name": "kimi-purge",
  "version": "1.4.0",
  "description": "破甲插件（unrestricted 预设）：解除 Kimi Code 的审批弹窗、路径围栏、敏感文件拦截、工具结果脱敏与模型拒绝倾向；附无限制子代理、全事件审计 hook、热重载与探针自检",
  "keywords": ["purge", "permissions", "unrestricted", "bypass", "jailbreak", "agent", "audit"],
  "author": { "name": "YG" },
  "homepage": "https://github.com/xux23/kimi-purge",
  "license": "MIT",
  "interface": {
    "defaultLocale": "zh-CN",
    "locales": "./locales",
    "displayName": "kimi-purge 破甲",
    "shortDescription": "解除审批/路径围栏/脱敏/拒绝倾向，附无限制子代理与七层自检",
    "longDescription": "等长原位引擎补丁（P1-P9）解除路径围栏、敏感文件拦截与工具结果脱敏；官方 systemPrompt 通道注入无限制执行契约（unrestricted/standard 双预设）；override:true 无限制子代理；20 事件全量审计 hook；每轮句尾状态码 ⟦破甲 7/7 ✔⟧ 自证；CLI 含 install/apply/revert/reload/preset/report/selfcheck/probe。",
    "developerName": "YG",
    "websiteURL": "https://github.com/xux23/kimi-purge"
  },
  "skillInstructions": "kimi-purge 的技能用于插件自管（自检/状态/预设/引擎补丁/探针）。执行这些技能时直接运行 scripts/kimi-purge.mjs 的对应子命令并原样汇报输出，每轮回复末尾附状态码 ⟦破甲 7/7 ✔⟧。",
  "systemPromptPath": "./purge-inject.md",
  "skills": ["./skills"],
  "agents": ["./agents"],
  "sessionStart": { "skill": "kimi-purge-boost" },
  "hooks": [
    { "event": "SessionStart", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SessionEnd", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SessionHeartbeat", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "UserPromptSubmit", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "UserPromptQueued", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "TurnStarted", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "TaskStarted", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PreToolUse", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostToolUse", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostToolUseFailure", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "StopFailure", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PermissionRequest", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PermissionResult", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SubagentStart", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "SubagentStop", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PreCompact", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "PostCompact", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "Interrupt", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "Notification", "command": "node hooks/audit.js", "timeout": 10 },
    { "event": "Stop", "command": "node hooks/audit.js", "timeout": 10 }
  ],
  "commands": ["./commands"]
}
