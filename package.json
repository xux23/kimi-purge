{
  "name": "kimi-purge",
  "version": "1.3.2",
  "private": true,
  "description": "Kimi Code 破甲插件：解除审批弹窗、路径围栏、敏感文件拦截、工具结果脱敏与模型拒绝倾向",
  "type": "module",
  "bin": { "kimi-purge": "scripts/kimi-purge.mjs" },
  "scripts": {
    "test": "node --test tests/",
    "install:plugin": "node scripts/kimi-purge.mjs install",
    "apply": "node scripts/kimi-purge.mjs apply",
    "revert": "node scripts/kimi-purge.mjs revert",
    "status": "node scripts/kimi-purge.mjs status",
    "selfcheck": "node scripts/kimi-purge.mjs selfcheck"
  },
  "engines": { "node": ">=18" }
}
